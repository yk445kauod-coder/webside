# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — never expose to the browser.
# Only needed if you add code that uses src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: share the auth cookie across subdomains (e.g. .example.com)
NEXT_PUBLIC_COOKIE_HOST=
