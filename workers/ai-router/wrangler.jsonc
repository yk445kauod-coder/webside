{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webside-ai-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://web-side.pages.dev,http://localhost:3000"
  },
  "observability": { "enabled": true }
}
